# ---------- OANDA ----------
# Get these from https://www.oanda.com → Manage API Access
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
# "live" for real money, "practice" for demo
OANDA_ENV=live

# ---------- Telegram ----------
# Get API_ID + API_HASH from https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Your phone number in international format, e.g. +447700900123
TELEGRAM_PHONE=
# Generated by running `python generate_session.py` locally — paste the long string here
TELEGRAM_SESSION_STRING=
# Comma-separated. Use negative numeric IDs (e.g. -1001234567890) or @usernames.
# To find a group ID, forward a message from the group to @userinfobot or @RawDataBot.
TELEGRAM_GROUP_IDS=

# ---------- Risk ----------
# 0.01 = 1% of balance per trade
RISK_PCT=0.01
# If the calculated units < 1 (very small accounts), force 1 unit anyway.
FORCE_MIN_UNITS=true

# ---------- Notifications (optional) ----------
# Your own Telegram user ID — bot sends you a DM when a trade is placed.
# Find it via @userinfobot. Leave blank to disable.
NOTIFY_CHAT_ID=
