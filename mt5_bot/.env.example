# ---- 5ers MT5 ----
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password_here
MT5_SERVER=FivePercentOnline-Real
MT5_INSTRUMENT=XAUUSD
MT5_MAGIC=271828
# Optional: only set if MT5 installed in non-default location
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ---- Telegram (SECOND account — different from OANDA bot) ----
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+44...
TELEGRAM_SESSION_STRING=
TELEGRAM_GROUP_IDS=-1003725317305
NOTIFY_CHAT_ID=

# ---- ORIGINAL account size (CRITICAL — set this) ----
# Even if you've already drawn down, this must be the ORIGINAL
# starting balance the prop firm uses for max-DD calculation.
# For 5ers $5K Bootcamp: 5000
MT5_INITIAL_BALANCE=5000

# ---- Risk (per signal, % of CURRENT equity) ----
# 0.5% per signal = $25 on $5K. With only $100 DD buffer left,
# 4 consecutive SLs would end the challenge. Acceptable trade-off
# for faster recovery; lower to 0.0025 (0.25%) for survival mode.
RISK_PCT=0.005

# ---- Prop firm safety (5ers Bootcamp = no daily limit, 5% max DD) ----
DAILY_LOSS_HALT_PCT=1.0          # disabled — 5ers Bootcamp has no daily cap
CONSECUTIVE_LOSS_HALT=2          # pause after 2 SLs in a row
CONSECUTIVE_LOSS_PAUSE_MIN=120   # 2-hour cooldown
TOTAL_DD_HALT_PCT=0.045          # halt at 4.5% DD (5% is bust line)
